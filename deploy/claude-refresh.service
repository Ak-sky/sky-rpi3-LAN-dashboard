# `claude doctor` is the ExecStart, not `claude auth status` or `--version` --
# both of those were tried first and confirmed (via credentials-file mtime)
# to NOT force a refresh of an expiring access token, they just report
# on the existing login state. `claude doctor`'s health check does an
# authenticated call that actually triggers the refresh.
[Unit]
Description=Refresh Claude Code Auth Token
After=network.target

[Service]
Type=oneshot
ExecStart=/home/pi/.local/bin/claude doctor

[Install]
WantedBy=default.target
